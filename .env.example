# ============================================
# UYIRNILAM AI - Environment Variables Template
# ============================================
# Rename this file to .env and fill in your actual keys.
# DO NOT commit the .env file to GitHub!
# ============================================

# Flask Configuration
FLASK_SECRET_KEY=your_secret_key_here
FLASK_ENV=production
DEBUG=False

# API Keys (Required for AI and Weather features)
WEATHER_API_KEY=your_openweathermap_api_key
GEMINI_API_KEY=your_google_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_claude_api_key

# Market Data (data.gov.in Agmarknet API)
DATA_GOV_API_KEY=your_data_gov_india_api_key

# Database Settings
DATABASE_URL=sqlite:///uyirnilam.db
JWT_SECRET_KEY=your_jwt_secret_key
